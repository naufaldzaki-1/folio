{
  "name": "folio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "db:status": "node --env-file=.env scripts/with-session-pooler.mjs migrate status",
    "db:migrate": "node --env-file=.env scripts/with-session-pooler.mjs migrate deploy",
    "db:baseline": "node --env-file=.env scripts/with-session-pooler.mjs migrate resolve --applied 20261121000000_init",
    "catalog:seed": "tsx scripts/seed-catalog.ts",
    "templates:seed": "tsx --env-file=.env scripts/seed-templates.ts",
    "llm:check": "tsx --env-file=.env scripts/llm-check.ts",
    "phase3:check": "tsx --env-file=.env scripts/phase3-check.ts",
    "storage:check": "tsx --env-file=.env scripts/storage-check.ts",
    "e2e:check": "tsx --env-file=.env scripts/e2e-check.ts",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "@supabase/supabase-js": "^2.119.2",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.10",
    "mammoth": "^1.13.0",
    "next": "^15.3.2",
    "nodemailer": "^10.6.1",
    "openai": "^7.62.0",
    "pdf-parse": "^1.1.1",
    "pdfkit": "^0.21.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.10",
    "@types/node": "^22.15.3",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.2",
    "postcss": "^8.5.3",
    "prisma": "^6.7.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3"
  }
}
